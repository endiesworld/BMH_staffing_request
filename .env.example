# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. In Kubernetes there is no file -- these same names are
# injected as environment variables by the Deployment and its Secret.

# Required. No default: an unset SECRET_KEY crashes at startup by design.
# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me

# Never true in production.
DEBUG=True

# Comma-separated. Empty + DEBUG=False means Django refuses every request,
# which is the intended way for a misconfigured deploy to fail.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, scheme included. Required behind the Cloudflare tunnel,
# where POSTs arrive with an https:// Origin. Unused locally over plain http.
CSRF_TRUSTED_ORIGINS=

# The wall clock the app presents and parses -- see docs/project-status.md.
TIME_ZONE=America/New_York

CELERY_BROKER_URL=redis://localhost:6379/0

# Unset falls back to SQLite, which is fine for tests and a fresh clone but is
# NOT equivalent: select_for_update() is a silent no-op there. To run against
# Postgres locally:
#   podman run -d --name bmh-postgres -p 5432:5432 \
#     -e POSTGRES_PASSWORD=bmh -e POSTGRES_USER=bmh -e POSTGRES_DB=bmh postgres:17
#   DATABASE_URL=postgres://bmh:bmh@localhost:5432/bmh
# DATABASE_URL=

# Seconds to hold a database connection open between requests. Total open
# connections = pods x gunicorn workers; raise Postgres max_connections with it.
CONN_MAX_AGE=60

# --- HTTPS hardening. Only read when DEBUG=False; ignored locally. -----------
# HSTS tells browsers never to try http for this host again, and is effectively
# IRREVERSIBLE for its own duration -- you cannot recall a cached max-age from
# the server. So ramp it: 3600 (1h) while settling the domain, then 86400,
# then 31536000 (1y) once you are confident.
SECURE_HSTS_SECONDS=3600
# Only after every subdomain is HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Only if you intend to be baked into browser binaries semi-permanently.
SECURE_HSTS_PRELOAD=False
